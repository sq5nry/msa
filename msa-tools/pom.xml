<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>msa</groupId>
    <artifactId>msa-java</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>msa-tools</artifactId>
  <name>MSA command-line tools</name>

  <dependencies>
    <dependency>
      <groupId>msa</groupId>
      <artifactId>msa-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- target/msa-probe.jar: one runnable jar with msa-core and msa-hw inside -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>msa-probe</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>msa.tools.MsaProbe</mainClass>
                  <manifestEntries>
                    <!-- lets "java -jar" call libusb without the native-access warning (JDK 22+) -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
